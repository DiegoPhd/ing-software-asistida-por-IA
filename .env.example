# Credenciales del despliegue de referencia (ADR-008).
# Son marcadores locales de desarrollo, no secretos reales: un despliegue de
# producción los sobrescribe por entorno y nunca los versiona.
POSTGRES_USER=incidentops
POSTGRES_PASSWORD=incidentops_local
POSTGRES_DB=incidentops

# Si la contraseña contiene caracteres especiales (@ : / ? #), codifícalos para
# URL antes de componer el DSN; por ejemplo @ se escribe %40.
DATABASE_URL=postgresql://incidentops:incidentops_local@localhost:5432/incidentops

# Puerto del host donde se publica la API (la base no se publica).
API_PORT=8000
