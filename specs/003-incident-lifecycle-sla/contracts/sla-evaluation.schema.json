{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://incidentops.local/contracts/sla-evaluation.schema.json",
  "title": "Evaluación de SLA de un incidente",
  "description": "Documento canónico de la auditoría, compartido por GET /api/v1/incidents/{incident_id}/sla y el comando sla.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "incident_id",
    "severity",
    "status",
    "created_at",
    "resolved_at",
    "reference_time",
    "elapsed_minutes",
    "allowed_minutes",
    "remaining_minutes",
    "is_breached",
    "requires_escalation",
    "window"
  ],
  "properties": {
    "incident_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "severity": {
      "type": "string",
      "enum": ["P0", "P1", "P2", "P3"]
    },
    "status": {
      "type": "string",
      "enum": ["OPEN", "IN_PROGRESS", "RESOLVED", "CLOSED"]
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3}|\\.[0-9]{6})?$"
    },
    "resolved_at": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3}|\\.[0-9]{6})?$"
    },
    "reference_time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3}|\\.[0-9]{6})?$",
      "description": "Instante aplicado; si la petición lo omitió, el instante actual resuelto una sola vez."
    },
    "elapsed_minutes": {
      "type": "integer",
      "minimum": 0,
      "description": "Minutos de SLA truncados; en terminales se congela en resolved_at."
    },
    "allowed_minutes": {
      "type": "integer",
      "enum": [60, 240, 480, 1440]
    },
    "remaining_minutes": {
      "type": "integer",
      "description": "allowed_minutes - elapsed_minutes; puede ser negativo si hay incumplimiento."
    },
    "is_breached": {
      "type": "boolean",
      "description": "elapsed_minutes > allowed_minutes, estricto."
    },
    "requires_escalation": {
      "type": "boolean",
      "description": "Estado activo, sin incumplimiento y elapsed_minutes >= int(allowed_minutes * 0.75)."
    },
    "window": {
      "type": "string",
      "enum": ["24x7", "BUSINESS_HOURS"],
      "description": "Ventana de cómputo derivada de la política: P0/P1 24x7; P2/P3 lunes a viernes 08:00-18:00."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "enum": ["RESOLVED", "CLOSED"] } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "resolved_at": { "type": "string" },
          "requires_escalation": { "const": false }
        }
      }
    },
    {
      "if": {
        "properties": { "is_breached": { "const": true } },
        "required": ["is_breached"]
      },
      "then": {
        "properties": { "requires_escalation": { "const": false } }
      }
    }
  ]
}
